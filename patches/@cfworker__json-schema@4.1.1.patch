+// Patched (see /patches/@cfworker__json-schema@4.1.1.patch): workerd exposes a
+// `self.location` whose fields don't always form a valid URL (e.g. under
+// nodejs_compat), which threw here at module load and crashed the whole
+// Worker before any request was handled. Fall back to the same safe default
+// this file already uses for non-browser environments.
+exports.initialBaseURI = (() => {
+    try {
+        return typeof self !== 'undefined' &&
+            self.location &&
+            self.location.origin !== 'null'
+            ?
+                new URL(self.location.origin + self.location.pathname + location.search)
+            : new URL('https://github.com/cfworker');
+    }
+    catch {
+        return new URL('https://github.com/cfworker');
+    }
+})();
