+// safe default this file already uses for non-browser environments.
+let initialBaseURI = (() => {
+	try {
+		return typeof self !== "undefined" && self.location && self.location.origin !== "null" ? new URL(self.location.origin + self.location.pathname + location.search) : new URL("https://github.com/cfworker");
+	} catch {
+		return new URL("https://github.com/cfworker");
+	}
+})();
 function dereference(schema, lookup = Object.create(null), baseURI = initialBaseURI, basePointer = "") {
