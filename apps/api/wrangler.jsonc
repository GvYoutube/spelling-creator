{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spelling-creator",
	"main": "src/index.js",
	"compatibility_date": "2026-05-28",
	// @cloudflare/puppeteer (used for crawler prerendering) needs the Node.js
	// compatibility runtime.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},

	"vars": {
		"ALLOWED_HOSTNAMES": "spellingcreator.org",
		"SUPABASE_URL": "https://hfkgrqihawgosalltjpy.supabase.co",
	},

	// Serve the built web SPA as static assets. The Worker runs first on every
	// request (run_worker_first) so it can intercept crawler navigations and
	// return a prerendered snapshot; everything else falls through to env.ASSETS.
	// not_found_handling serves index.html for client-side (BrowserRouter) routes.
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},

	// Browser Rendering binding — headless Chromium used to prerender pages for
	// crawlers/social scrapers via @cloudflare/puppeteer.
	"browser": {
		"binding": "BROWSER",
	},

	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "e3d5364c3c8f4637937bb07a17ffbb38",
		},
	],

	// Live-collaboration coordinator. One CollabRoom Durable Object per session
	// (addressed by the host's share code) relays edits/cursors/chat over a single
	// WebSocket and enforces per-room/per-connection limits. See src/collab-room.js
	// and handleCollab in src/index.js. SQLite-backed (the room caches the doc).
	"durable_objects": {
		"bindings": [{ "name": "COLLAB_ROOM", "class_name": "CollabRoom" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollabRoom"] }],

	// R2 bucket holding lesson images as binary objects, keyed by their SHA-256
	// content hash. Served publicly by GET /images/:hash and written by the
	// authenticated PUT /images/:hash (see src/index.js). Create it once with:
	//   wrangler r2 bucket create spelling-creator-images
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "spelling-creator-images",
		},
	],
}
