# Example configuration for the docker-compose.yml in this directory.
#
#   node scripts/generate-env.mjs
#
# ...which writes a .env from this file with every credential filled in, leaving
# only PUBLIC_URL and the SMTP block to set by hand. Prefer it to copying this
# file and editing it: ANON_KEY and SERVICE_ROLE_KEY are JWTs that have to be
# signed with the JWT_SECRET below, and a value that is not a valid token fails
# in a way that points everywhere except at itself — PostgREST calls it a signing
# error, GoTrue calls it a permissions error, and the app answers 502.
#
# Then replace every value below. Nothing here is a secret — these are example
# values in a public repository, and an instance left running with them is
# readable and writable by anyone who has read this file.
#
# See /docs/monorepo/self-hosting for what each service is and what the app does
# without it.

# ---------------------------------------------------------------------------
# Where this instance is reachable
# ---------------------------------------------------------------------------
# The public origin. This is baked into the SPA bundle at build time — Vite
# substitutes it — so changing it means `docker compose build`, not just a
# restart.
PUBLIC_URL=http://localhost:8080
PUBLIC_HOSTNAME=localhost
PUBLIC_PORT=8080

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Keep this to letters and digits. It is embedded in the connection URLs that
# PostgREST and GoTrue use, so a password containing @ : / ? # or & splits the
# URL and the service fails to connect — with an error that talks about hosts
# and ports rather than about the password.
POSTGRES_PASSWORD=change-this-postgres-password

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# The secret GoTrue signs session tokens with and PostgREST verifies them
# against. At least 32 characters:
#
#   openssl rand -base64 48
JWT_SECRET=change-this-to-at-least-thirty-two-characters

# Two long-lived JWTs signed with JWT_SECRET above, carrying `"role": "anon"` and
# `"role": "service_role"`. PostgREST reads the role claim to decide what the
# caller may do, so these are not interchangeable:
#
#   ANON_KEY          ships to the browser. It is public by design.
#   SERVICE_ROLE_KEY  bypasses RLS. Server-side only — anyone holding it can read
#                     and write every row in the database, including other
#                     people's private lesson answers.
#
# `node scripts/generate-env.mjs` mints both, signed with the secret above, and
# is the reason not to fill these in by hand: the two have to agree with
# JWT_SECRET and with each other, and the placeholders below are not tokens. Left
# as they are, PostgREST answers "JWSError ... Expected 3 parts; got 1" and the
# app answers 502.
ANON_KEY=replace-with-a-jwt-whose-role-claim-is-anon
SERVICE_ROLE_KEY=replace-with-a-jwt-whose-role-claim-is-service_role

# ---------------------------------------------------------------------------
# Admin / diagnostics
# ---------------------------------------------------------------------------
# Gates GET /_diagnostics, which reports what every dependency is doing and what
# is wrong with it. Optional: the same report is printed to the app's log at
# startup (`docker compose logs app`), so this is only needed to ask again
# without restarting. It also gates the one-time admin backfills.
#
#   openssl rand -hex 24
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# The compose file runs RustFS. The app speaks plain S3, so Garage, SeaweedFS,
# Ceph RGW or real S3 work the same — change the image and endpoint, not this.
#
# Letters and digits again: unlike the database password these are not put in a
# URL, but keeping both to the same rule is one less thing to remember.
S3_ACCESS_KEY=change-this-access-key
S3_SECRET_KEY=change-this-secret-key

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Sign-in is by magic link, so this is not optional: without working SMTP nobody
# can create an account or log in. Any provider will do. For a local trial, run
# something like MailHog and point at it.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-this
SMTP_PASS=change-this
SMTP_FROM=noreply@example.com
